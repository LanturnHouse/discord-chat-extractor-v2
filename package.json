{
  "name": "discord-chat-extractor-v2",
  "version": "2.0.1",
  "description": "Chrome MV3 extension: add Discord channels and DMs to a download list from the web client and export them to TXT / HTML / Markdown / Excel / CSV / JSON.",
  "license": "MIT",
  "homepage": "https://github.com/LanturnHouse/discord-chat-extractor-v2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LanturnHouse/discord-chat-extractor-v2.git"
  },
  "bugs": {
    "url": "https://github.com/LanturnHouse/discord-chat-extractor-v2/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "pack": "node scripts/pack.mjs",
    "preview:popup": "node scripts/preview-popup.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
